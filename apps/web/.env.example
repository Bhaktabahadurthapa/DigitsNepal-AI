# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://digitsnepal:digitsnepal_dev@localhost:5433/digitsnepal
# Public base URL of the web app (used by auth callbacks and emails)
BETTER_AUTH_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 32`. REQUIRED in production.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789

# ── AI service (services/ai) ─────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8100
# Shared secret between web/worker and the AI service. REQUIRED in production.
AI_SERVICE_TOKEN=dev-ai-token

# ── AI cost controls (USD) ───────────────────────────────────────────
AI_MONTHLY_BUDGET_USD=40
AI_MONTHLY_SOFT_LIMIT_RATIO=0.8
AI_TUTOR_DAILY_MESSAGES_PER_USER=40
AI_TUTOR_PER_MINUTE_PER_USER=6
AI_STUDIO_DAILY_GENERATIONS_PER_USER=10

# ── Storage ──────────────────────────────────────────────────────────
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com or http://localhost:9000
S3_REGION=auto
S3_BUCKET=digitsnepal-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=10485760
SOURCE_RETENTION_DAYS=365
# Optional ClamAV daemon for upload scanning (host:port). Empty = scanning disabled.
CLAMAV_HOST=

# ── Email (password reset). Empty SMTP_URL = links are logged to the server console (dev only).
SMTP_URL=
EMAIL_FROM="DigitsNepal AI <no-reply@digitsnepal.com>"

# ── Bootstrap: emails that are granted the admin role on sign-up (comma-separated)
ADMIN_EMAILS=
