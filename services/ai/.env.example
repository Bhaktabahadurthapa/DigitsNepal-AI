AI_SERVICE_TOKEN=dev-ai-token
# extractive (offline, no LLM, free) | gemini | openai
AI_PROVIDER=extractive
# Embedding provider may differ from the generation provider (extractive | gemini | openai)
AI_EMBED_PROVIDER=extractive
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# USD per 1M tokens. VERIFY against the provider's current price list before relying on cost reports.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.40
PRICE_EMBED_PER_MTOK=0.15
MAX_OUTPUT_TOKENS=2048
